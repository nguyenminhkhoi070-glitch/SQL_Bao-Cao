-- 1. HÀM TÌM PHÒNG TRỐNG THEO LOẠI PHÒNG VÀ KHOẢNG THỜI GIAN
-- Trả về bảng danh sách các phòng còn trống
CREATE OR ALTER FUNCTION fn_TimPhongTrong (
    @MaLoaiPhong VARCHAR(10),
    @NgayNhan DATE,
    @NgayTra DATE
)
RETURNS TABLE
AS
RETURN (
    SELECT P.MaPhong, LP.TenPhong, P.DonGiaTheoNgay, KV.TenKhuVuc
    FROM Phong P
    JOIN LoaiPhong LP ON P.MaLoaiPhong = LP.MaLoaiPhong
    JOIN KhuVuc KV ON P.MaKhuVuc = KV.MaKhuVuc
    WHERE P.MaLoaiPhong = @MaLoaiPhong
      AND P.TinhTrangPhong = N'Trống'
      AND P.MaPhong NOT IN (
          SELECT CTDP.MaPhong
          FROM ChiTietDatPhong CTDP
          JOIN PhieuDatPhong PDP ON CTDP.MaDatPhong = PDP.MaDatPhong
          WHERE PDP.TrangThaiDat != N'Đã hủy'
            -- Kiểm tra giao nhau giữa 2 khoảng thời gian
            AND (@NgayNhan < PDP.NgayTraDuKien AND @NgayTra > PDP.NgayNhanDuKien)
      )
);
GO

-- 2. HÀM TÍNH TỔNG DOANH THU THEO THÁNG/NĂM
CREATE OR ALTER FUNCTION fn_DoanhThuThang (
    @Thang INT, 
    @Nam INT
)
RETURNS DECIMAL(18,2)
AS
BEGIN
    DECLARE @TongDoanhThu DECIMAL(18,2);
    
    SELECT @TongDoanhThu = SUM(TongTien)
    FROM HoaDon
    WHERE MONTH(NgayThanhToan) = @Thang AND YEAR(NgayThanhToan) = @Nam;
    
    RETURN ISNULL(@TongDoanhThu, 0);
END;
GO

-- 3. THỦ TỤC THÊM DỊCH VỤ SỬ DỤNG CHO PHIẾU ĐẶT PHÒNG
-- Lưu ý: Bảng ChiTietSuDungDichVu có khóa chính là (MaDatPhong, MaDichVu)
-- Nên nếu khách dùng cùng 1 dịch vụ 2 lần, ta phải UPDATE số lượng thay vì INSERT
CREATE OR ALTER PROCEDURE sp_ThemDichVu (
    @MaDatPhong VARCHAR(10),
    @MaDichVu VARCHAR(10),
    @SoLuong INT
)
AS
BEGIN
    DECLARE @DonGia DECIMAL(18,2);
    
    -- Lấy đơn giá hiện tại của dịch vụ
    SELECT @DonGia = DonGia FROM DichVu WHERE MaDichVu = @MaDichVu;
    
    -- Kiểm tra xem dịch vụ này đã được thêm cho phiếu đặt phòng này chưa
    IF EXISTS (SELECT 1 FROM ChiTietSuDungDichVu WHERE MaDatPhong = @MaDatPhong AND MaDichVu = @MaDichVu)
    BEGIN
        -- Nếu có rồi thì cộng dồn số lượng
        UPDATE ChiTietSuDungDichVu
        SET SoLuong = SoLuong + @SoLuong,
            ThoiDiemSuDung = GETDATE(),
            DonGiaTaiThoiDiemSuDung = @DonGia
        WHERE MaDatPhong = @MaDatPhong AND MaDichVu = @MaDichVu;
    END
    ELSE
    BEGIN
        -- Nếu chưa có thì thêm mới
        INSERT INTO ChiTietSuDungDichVu (MaDatPhong, MaDichVu, SoLuong, ThoiDiemSuDung, DonGiaTaiThoiDiemSuDung)
        VALUES (@MaDatPhong, @MaDichVu, @SoLuong, GETDATE(), @DonGia);
    END
END;
GO

-- 4. THỦ TỤC CẬP NHẬT TRẠNG THÁI KHI KHÁCH CHECK-OUT
CREATE OR ALTER PROCEDURE sp_CheckOut (
    @MaDatPhong VARCHAR(10)
)
AS
BEGIN
    -- 1. Cập nhật trạng thái phiếu đặt phòng
    UPDATE PhieuDatPhong
    SET TrangThaiDat = N'Đã trả phòng'
    WHERE MaDatPhong = @MaDatPhong;

    -- 2. Cập nhật trạng thái các phòng thuộc phiếu đặt này thành 'Trống'
    UPDATE Phong
    SET TinhTrangPhong = N'Trống'
    WHERE MaPhong IN (
        SELECT MaPhong 
        FROM ChiTietDatPhong 
        WHERE MaDatPhong = @MaDatPhong
    );
END;
GO

-- 5. HÀM TÍNH TỔNG TIỀN PHÒNG CỦA MỘT PHIẾU ĐẶT PHÒNG
CREATE OR ALTER FUNCTION fn_TinhTienPhong (
    @MaDatPhong VARCHAR(10)
)
RETURNS DECIMAL(18,2)
AS
BEGIN
    DECLARE @TienPhong DECIMAL(18,2);
    DECLARE @SoNgay INT;
    DECLARE @NgayNhan DATE, @NgayTra DATE;

    -- Lấy ngày nhận và ngày trả dự kiến
    SELECT @NgayNhan = NgayNhanDuKien, @NgayTra = NgayTraDuKien
    FROM PhieuDatPhong 
    WHERE MaDatPhong = @MaDatPhong;

    -- Tính số ngày ở (nếu cùng ngày thì tính 1 ngày)
    SET @SoNgay = DATEDIFF(DAY, @NgayNhan, @NgayTra);
    IF @SoNgay = 0 
        SET @SoNgay = 1;

    -- Tính tổng tiền dựa trên giá thuê lúc đặt
    SELECT @TienPhong = SUM(GiaThueLucDat * SoLuongPhong * @SoNgay)
    FROM ChiTietDatPhong
    WHERE MaDatPhong = @MaDatPhong;

    RETURN ISNULL(@TienPhong, 0);
END;
GO

