-- 1. HÀM TÌM PHÒNG TRỐNG THEO LOẠI PHÒNG VÀ KHOẢNG THỜI GIAN
-- Trả về bảng danh sách các phòng còn trống
CREATE OR ALTER FUNCTION fn_TimPhongTrong (
    @MaLoaiPhong VARCHAR(10),
    @NgayNhan DATE,
    @NgayTra DATE
)
RETURNS TABLE
AS
RETURN (
    SELECT P.MaPhong, LP.TenPhong, P.DonGiaTheoNgay, KV.TenKhuVuc
    FROM Phong P
    JOIN LoaiPhong LP ON P.MaLoaiPhong = LP.MaLoaiPhong
    JOIN KhuVuc KV ON P.MaKhuVuc = KV.MaKhuVuc
    WHERE P.MaLoaiPhong = @MaLoaiPhong
      AND P.TinhTrangPhong = N'Trống'
      AND P.MaPhong NOT IN (
          SELECT CTDP.MaPhong
          FROM ChiTietDatPhong CTDP
          JOIN PhieuDatPhong PDP ON CTDP.MaDatPhong = PDP.MaDatPhong
          WHERE PDP.TrangThaiDat != N'Đã hủy'
            -- Kiểm tra giao nhau giữa 2 khoảng thời gian
            AND (@NgayNhan < PDP.NgayTraDuKien AND @NgayTra > PDP.NgayNhanDuKien)
      )
);

-- 2. HÀM TÍNH TỔNG DOANH THU THEO THÁNG/NĂM
CREATE OR ALTER FUNCTION fn_DoanhThuThang (
    @Thang INT, 
    @Nam INT
)
RETURNS DECIMAL(18,2)
AS
BEGIN
    DECLARE @TongDoanhThu DECIMAL(18,2);
    
    SELECT @TongDoanhThu = SUM(TongTien)
    FROM HoaDon
    WHERE MONTH(NgayThanhToan) = @Thang AND YEAR(NgayThanhToan) = @Nam;
    
    RETURN ISNULL(@TongDoanhThu, 0);
END;

-- 3. HÀM LẤY CHI TIẾT DỊCH VỤ ĐÃ SỬ DỤNG THEO PHIẾU ĐẶT PHÒNG
CREATE OR ALTER FUNCTION dbo.fn_ChiTietDichVuTheoDatPhong
(
    @MaDatPhong VARCHAR(10)
)
RETURNS TABLE
AS
RETURN
(
    SELECT
        MaDatPhong,
        MaDichVu,
        SoLuong,
        ThoiDiemSuDung,
        DonGiaTaiThoiDiemSuDung,
        CAST(SoLuong * DonGiaTaiThoiDiemSuDung AS DECIMAL(18,2))
            AS ThanhTienDichVu
    FROM ChiTietSuDungDichVu
    WHERE MaDatPhong = @MaDatPhong
);

-- 4. HÀM LẤY THÔNG TIN PHÒNG VÀ TRẠNG THÁI ĐẶT PHÒNG KHI CHECK-OUT
CREATE OR ALTER FUNCTION dbo.fn_ThongTinPhongCheckOut
(
    @MaDatPhong VARCHAR(10)
)
RETURNS TABLE
AS
RETURN
(
    SELECT
        PDP.MaDatPhong,
        PDP.TrangThaiDat,
        CTDP.MaPhong,
        P.TinhTrangPhong
    FROM PhieuDatPhong AS PDP
    LEFT JOIN ChiTietDatPhong AS CTDP
        ON PDP.MaDatPhong = CTDP.MaDatPhong
    LEFT JOIN Phong AS P
        ON CTDP.MaPhong = P.MaPhong
    WHERE PDP.MaDatPhong = @MaDatPhong
);

-- 5. HÀM TÍNH TỔNG TIỀN PHÒNG CỦA MỘT PHIẾU ĐẶT PHÒNG
CREATE OR ALTER FUNCTION fn_TinhTienPhong (
    @MaDatPhong VARCHAR(10)
)
RETURNS DECIMAL(18,2)
AS
BEGIN
    DECLARE @TienPhong DECIMAL(18,2);
    DECLARE @SoNgay INT;
    DECLARE @NgayNhan DATE, @NgayTra DATE;

    -- Lấy ngày nhận và ngày trả dự kiến
    SELECT @NgayNhan = NgayNhanDuKien, @NgayTra = NgayTraDuKien
    FROM PhieuDatPhong 
    WHERE MaDatPhong = @MaDatPhong;

    -- Tính số ngày ở (nếu cùng ngày thì tính 1 ngày)
    SET @SoNgay = DATEDIFF(DAY, @NgayNhan, @NgayTra);
    IF @SoNgay = 0 
        SET @SoNgay = 1;

    -- Tính tổng tiền dựa trên giá thuê lúc đặt
    SELECT @TienPhong = SUM(GiaThueLucDat * SoLuongPhong * @SoNgay)
    FROM ChiTietDatPhong
    WHERE MaDatPhong = @MaDatPhong;

    RETURN ISNULL(@TienPhong, 0);
END;

